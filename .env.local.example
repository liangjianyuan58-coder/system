# ── Google サービスアカウント ──
# サービスアカウントのメールアドレス（〜@〜.iam.gserviceaccount.com）
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 秘密鍵。JSON鍵の "private_key" の値をそのまま貼る。
# 改行を含むため、ダブルクオートで囲む（\n のままでもOK：コード側で復元します）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...省略...\n-----END PRIVATE KEY-----\n"

# 保存先スプレッドシートのID（URLの /d/ と /edit の間の文字列）
SHEET_ID=1AbC...your-sheet-id...

# ── Gemini API（AI査定・FB用）──
# Google AI Studio (https://aistudio.google.com/apikey) で取得したキー
GEMINI_API_KEY=AIza...your-gemini-api-key...

# ── LINE Messaging API（通知・友だち連携用）──
# ※ LINE Notify は2025/3で終了。公式アカウント＋Messaging APIが必須。
# LINE Developers コンソールで Messaging API チャネルを作成して取得
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# 公開後のアプリURL（LINE通知文に載せる）。例: https://havefun.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel Cron 保護用の任意シークレット（設定すると cron 以外からの実行を拒否）
CRON_SECRET=any-random-string

# ── LINE Messaging API（リマインド通知・LINE上の添削Bot用）──
# LINE Developers の Messaging API チャネルから取得
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# Cron（/api/cron/remind）の不正実行防止トークン（任意の文字列）
CRON_SECRET=any-long-random-string
